# ------------------------------------------------------------------
# 🟢 FRONTEND ENVIRONMENT VARIABLES (Vite / Vercel SPA)
# ------------------------------------------------------------------
# Only public variables prefixed with VITE_ are bundled into client code.
# NEVER place secret API keys (OpenAI, Anthropic, Gemini, Resend, LemonSqueezy) here!
# All LLM and third-party orchestration must run via backend API / Edge Functions.

# 1. Supabase (Database & Auth - Safe for Client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# 2. Backend API Endpoint (Optional / Future Backend Services)
VITE_API_URL=https://api.yourdomain.com
VITE_WEBSOCKET_URL=wss://api.yourdomain.com/ws

# ------------------------------------------------------------------
# 🔴 BACKEND / SERVER-ONLY KEYS (Python Core / Edge Functions)
# ------------------------------------------------------------------
# Store these strictly in your secure backend server or Supabase Edge Functions:
# - ANTHROPIC_API_KEY
# - OPENAI_API_KEY
# - GEMINI_API_KEY / GOOGLE_AI_API_KEY
# - TAVILY_API_KEY
# - FIRECRAWL_API_KEY
# - ELEVENLABS_API_KEY
# - REPLICATE_API_KEY
# - AYRSHARE_API_KEY
# - PEXELS_API_KEY
# - RESEND_API_KEY
# - LEMONSQUEEZY_API_KEY
# - LEMONSQUEEZY_WEBHOOK_SECRET
